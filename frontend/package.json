{
  "name": "nami-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=chromium",
    "lint": "eslint .",
    "test": "vitest run",
    "test:budget": "node --test scripts/check-bundle-budget.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "9.17.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/d3-scale": "^4.0.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.18.1",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
